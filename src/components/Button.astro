---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'light';
  size?: 'md' | 'sm';
  target?: string;
  rel?: string;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  target,
  rel,
  class: className,
} = Astro.props;

const sizeClasses = size === 'sm' ? 'px-4 py-2 text-xs' : 'px-6 py-3 text-sm';

const variantClasses = {
  primary: 'bg-ink text-paper shadow-sm hover:bg-accent hover:shadow-md hover:-translate-y-0.5',
  secondary: 'border-2 border-ink text-ink hover:bg-ink hover:text-paper hover:-translate-y-0.5',
  light: 'border-2 border-paper/70 text-paper hover:border-paper hover:bg-paper hover:text-ink hover:-translate-y-0.5',
}[variant];
---

<a
  href={href}
  target={target}
  rel={rel}
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full font-semibold tracking-wide transition-all duration-200',
    sizeClasses,
    variantClasses,
    className,
  ]}
>
  <slot />
</a>
