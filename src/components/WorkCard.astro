---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, client, role, summary, tags } = entry.data;
---

<a
  href={`/work/${entry.id}`}
  class="group flex flex-col gap-3 border-b border-line py-8 first:pt-0 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8"
>
  <div class="flex-1">
    <h3 class="font-display text-2xl text-ink transition-colors group-hover:text-accent">
      {title}
    </h3>
    <p class="mt-2 max-w-prose text-muted">{summary}</p>
    {
      tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2 text-xs uppercase tracking-wide text-muted">
          {tags.map((tag) => (
            <li class="rounded-full border border-line px-2.5 py-1">{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
  <div class="shrink-0 text-sm text-muted sm:text-right">
    <p>{role}</p>
    {client && <p class="text-ink/70">{client}</p>}
  </div>
</a>
