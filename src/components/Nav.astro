---
const links = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="relative isolate overflow-hidden bg-accent">
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-cover bg-center"
    style="background-image: url('/images/masthead-forest.jpg');"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-transparent to-accent-soft/30"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto flex max-w-content items-center justify-between gap-3 px-6 py-5 sm:px-10">
    <a
      href="/"
      class="group flex shrink-0 items-center gap-2 font-display text-base font-semibold tracking-tight text-paper sm:gap-2.5 sm:text-xl"
    >
      <span
        class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent-soft transition-transform duration-200 group-hover:scale-125 sm:h-2 sm:w-2"
      ></span>
      <span class="whitespace-nowrap transition-colors group-hover:text-accent-soft">
        Taylor Bornstein
      </span>
    </a>
    <nav class="flex items-center gap-3.5 text-xs sm:gap-7 sm:text-sm">
      {
        links.map((link) => {
          const isActive =
            currentPath === link.href || currentPath.startsWith(`${link.href}/`);
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'relative pb-1.5 font-medium transition-colors',
                isActive ? 'text-paper' : 'link-underline text-paper/70 hover:text-paper',
              ]}
            >
              {link.label}
              {isActive && (
                <span class="absolute inset-x-0 bottom-0 h-0.5 rounded-full bg-accent-soft" />
              )}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
