---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';

const allWork = await getCollection('work', ({ data }) => !data.draft);
const featured = allWork
  .filter((entry) => entry.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const shown = featured.length > 0
  ? featured
  : allWork.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);

const spotlight = allWork.find((entry) => entry.id === 'bolt-blog-visionary-tech');
---

<BaseLayout title="Taylor Bornstein">
  <section class="mx-auto max-w-content px-6 pb-16 pt-20 sm:px-10 sm:pt-28">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="text-sm uppercase tracking-[0.2em] text-accent">Content &amp; Communications Director</p>
        <div class="mt-6 space-y-4 font-display text-base font-normal leading-relaxed text-ink sm:text-lg">
          <h1 class="font-display text-base font-medium leading-relaxed text-accent sm:text-lg">
            I'm very good at words.
          </h1>
          <p>
            And I'm very good at crafting a system through which they can be used to make
            anyone think, "that might be exactly what I need."
          </p>
          <p>I like to build things. Programs. Teams. AI content engines.</p>
          <p>
            I like to solve problems. I work across teams and departments, helping make
            something big happen that no one could have done alone.
          </p>
          <p>I like telling good stories well.</p>
          <p>
            I'm not good at a lot of things. But I am good at knowing when a sentence is
            working and when it isn't.
          </p>
        </div>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button href="/work" variant="primary">See the work</Button>
          <Button href="/contact" variant="secondary">Get in touch</Button>
        </div>
      </div>

      {
        spotlight && (
          <a
            href={`/work/${spotlight.id}`}
            class="group flex flex-col justify-center rounded-2xl border border-line bg-paper p-6 transition-colors hover:border-accent sm:p-8"
          >
            <p class="text-xs uppercase tracking-[0.2em] text-accent">Featured story</p>
            <h2 class="mt-3 font-display text-2xl text-ink transition-colors group-hover:text-accent sm:text-3xl">
              {spotlight.data.title}
            </h2>
            <p class="mt-4 max-w-prose text-muted">{spotlight.data.summary}</p>
            <p class="link-underline mt-5 inline-block w-fit text-sm font-medium text-accent">
              Read the story &rarr;
            </p>
          </a>
        )
      }
    </div>
  </section>

  <section class="border-t border-line bg-ink text-paper">
    <div class="mx-auto max-w-content px-6 py-16 sm:px-10">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <h2 class="font-display text-2xl">Selected work</h2>
        <Button href="/work" variant="light" size="sm">View all work &rarr;</Button>
      </div>
      <div class="mt-8 divide-y divide-paper/15">
        {
          shown.map((entry) => (
            <a
              href={`/work/${entry.id}`}
              class="group grid gap-2 py-8 first:pt-0 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-8"
            >
              <div>
                <h3 class="font-display text-2xl transition-colors group-hover:text-accent-soft">
                  {entry.data.title}
                </h3>
                <p class="mt-2 max-w-prose text-paper/70">{entry.data.summary}</p>
              </div>
              <p class="text-sm text-paper/60 sm:text-right">{entry.data.role}</p>
            </a>
          ))
        }
        {
          shown.length === 0 && (
            <p class="py-8 text-paper/70">
              Work samples are on the way — check back soon.
            </p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
