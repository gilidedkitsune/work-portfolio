---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import type { CollectionEntry } from 'astro:content';

const allWork = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

function eraFor(entry: CollectionEntry<'work'>): string {
  const { client, role } = entry.data;
  if (client === 'Bolt.new') {
    return 'Bolt.new';
  }
  if (client === 'Mendix') {
    return 'Mendix';
  }
  if (client === 'IronMountain.com' || role === 'Marketing Copywriter') {
    return 'Iron Mountain';
  }
  return 'Early Career & Freelance';
}

const eraOrder = ['Bolt.new', 'Mendix', 'Iron Mountain', 'Early Career & Freelance'];
const groups = eraOrder
  .map((era) => ({ era, entries: allWork.filter((entry) => eraFor(entry) === era) }))
  .filter((group) => group.entries.length > 0);
---

<BaseLayout title="Work" description="Selected writing, strategy, and content direction work by Taylor Bornstein.">
  <section class="mx-auto max-w-content px-6 pb-24 pt-16 sm:px-10 sm:pt-24">
    <p class="text-sm uppercase tracking-[0.2em] text-accent">Work</p>
    <h1 class="mt-4 max-w-2xl font-display text-4xl text-ink sm:text-5xl">Selected projects</h1>
    <p class="mt-4 max-w-prose text-muted">
      Work spanning content direction, PR, and hands-on writing — grouped by chapter. Get in
      touch for the full portfolio or references.
    </p>

    {
      groups.map((group, i) => (
        <div class:list={['mt-16 first:mt-12', i > 0 && 'border-t border-line pt-16']}>
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <h2 class="font-display text-3xl text-ink">{group.era}</h2>
            <span class="text-sm uppercase tracking-[0.2em] text-accent">
              {group.entries.length} {group.entries.length === 1 ? 'project' : 'projects'}
            </span>
          </div>
          <div class="mt-6">
            {group.entries.map((entry) => (
              <WorkCard entry={entry} />
            ))}
          </div>
        </div>
      ))
    }
    {
      allWork.length === 0 && (
        <p class="mt-12 py-8 text-muted">Work samples are on the way — check back soon.</p>
      )
    }
  </section>
</BaseLayout>
